# Public LiveKit endpoint
LIVEKIT_URL=wss://livekit.simplething.id.vn

# Must match /opt/livekit/livekit.yaml on the home server
LIVEKIT_API_KEY=replace_me
LIVEKIT_API_SECRET=replace_me

# Single-room demo settings
MEETING_ROOM=paperless-demo
MEETING_CODE=DEMO-001
INTERNAL_API_KEY=replace_with_random_value
BACKEND_INTERNAL_URL=http://127.0.0.1:8000/api/internal/events
AI_SERVER_WS_URL=ws://127.0.0.1:8001
AI_SERVER_HTTP_URL=http://127.0.0.1:8001
AUDIO_FRAME_SIZE_MS=20

# Linux-native runtime storage. Source code remains under /mnt/d.
DATABASE_PATH=/home/ntd/meeting_runtime/data/meeting.db
SPEAKER_DATABASE_PATH=/home/ntd/meeting_runtime/data/qdrant_speakers
ZIPFORMER_MODEL_DIR=/home/ntd/meeting_runtime/Zipformer-30M-RNNT-Streaming-6000h
# Modified-beam width. Benchmark 4/8/12 before raising this for every mic.
ZIPFORMER_MAX_ACTIVE_PATHS=4
# Streaming receptive-field variant: 16 = lowest latency; 32/64 = more
# acoustic context and potentially better fast-speech accuracy.
ZIPFORMER_CHUNK_SIZE=32
# RNNT blank-logit penalty; keep 0 until a target-audio A/B supports a change.
ZIPFORMER_BLANK_PENALTY=0.4
# Shared meeting glossary. Dynamic entries are stored separately with source,
# confidence and expiry; never add unverified raw ASR text here.
ADAPTIVE_DICTIONARY_ENABLED=true
ADAPTIVE_DICTIONARY_STATE_PATH=/home/ntd/meeting_runtime/data/adaptive_dictionary.json
# Contextual decoding remains opt-in until its meeting-specific A/B test passes.
ZIPFORMER_HOTWORDS_ENABLED=false
ZIPFORMER_HOTWORDS_SCORE=1.5
ZIPFORMER_HOTWORDS_MIN_CONFIDENCE=0.9
ADAPTIVE_DICTIONARY_PHONETIC_MIN_CONFIDENCE=0.75
ADAPTIVE_DICTIONARY_TITLE_TTL_HOURS=12
ZIPFORMER_HOTWORDS_PATH=/home/ntd/meeting_runtime/data/zipformer_hotwords.txt
ZIPFORMER_BPE_VOCAB_PATH=/home/ntd/meeting_runtime/data/zipformer.bpe.vocab
SPEAKER_MATCH_THRESHOLD=0.86
SPEAKER_OPEN_SET_FLOOR=0.86
SPEAKER_SINGLE_PROFILE_THRESHOLD=0.90
SPEAKER_MATCH_MARGIN=0.035
SPEAKER_CONSENSUS_RATIO=0.67
SPEAKER_MIN_ID_SECONDS=2.5
SPEAKER_ID_WINDOW_SECONDS=3.0
SPEAKER_ID_MAX_WINDOWS=2
SPEAKER_EARLY_EXIT_SCORE_BUFFER=0.025
SPEAKER_EARLY_EXIT_MARGIN_BUFFER=0.015
WAVLM_NUM_THREADS=2

# Room-wide VAD timeline and lightweight ASR-only preprocessing.
# WavLM always receives the original VAD-selected waveform.
ENABLE_ASR_PREPROCESSING=true
ASR_HIGH_PASS_HZ=70
ASR_TARGET_RMS=0.065
ASR_FINAL_PADDING_SECONDS=0.66
# Silero endpointing. 0.9s lets final transcript/minutes update shortly
# after a speaker stops; calibrate these with streaming_regression.py.
VAD_MIN_SPEECH_SECONDS=0.20
VAD_MIN_SILENCE_SECONDS=0.90
VAD_PREFIX_PADDING_SECONDS=0.50
VAD_ACTIVATION_THRESHOLD=0.50
VAD_DEACTIVATION_THRESHOLD=0.30
# Decode all mics continuously; final timeline selection still picks the
# strongest candidate. Set false only for a measured CPU-constrained setup.
ASR_DECODE_ALL_MICS=true
ASR_SOFT_SPLIT_SECONDS=15
ASR_HARD_SPLIT_SECONDS=30
ASR_SPLIT_MIN_SILENCE_SECONDS=0.30
# none | dpdfnet_baseline. Keep DPDFNet off until an A/B on the target room
# proves it improves WER; it only affects the ASR branch.
ASR_ENHANCER=none
ASR_ENHANCER_MODEL=/home/ntd/meeting_runtime/models/dpdfnet_baseline.onnx
ASR_ENHANCER_THREADS=1
# Dynamic raw/DPDFNet blend: bypass at clean SNR, stronger below full SNR.
ASR_ENHANCER_BYPASS_SNR_DB=15
ASR_ENHANCER_FULL_SNR_DB=3
ASR_ENHANCER_MAX_MIX=0.65
ASR_ENHANCER_ATTACK=0.20
ASR_ENHANCER_RELEASE=0.65
TIMELINE_ASR_QUALITY_MARGIN=3.5
TIMELINE_ASR_RMS_RATIO=0.48
TIMELINE_FINAL_SETTLE_SECONDS=0.75

# Existing AI services.  Per-segment LLM cleanup is disabled: raw ASR plus
# phonetic recovery is stored as transcript evidence for the Minutes Composer.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
ENABLE_LLM_REFINEMENT=false
LLM_TIMEOUT_SECONDS=5
LLM_INLINE_WAIT_SECONDS=0.35
# direct = Qwen cleanup baseline. sailor_candidate = Sailor may only accept
# or reject the exact dictionary/G2P correction; it cannot generate text.
REFINEMENT_BACKEND=direct
SAILOR_MODEL=sailor2:1b
SAILOR_KEEP_ALIVE=5m
SAILOR_NUM_THREADS=2
SAILOR_LANGUAGE=vi-VN
SAILOR_CONTEXT_TURNS=2
FINAL_LATENCY_LIMIT_SECONDS=6

# Official minutes only.  Qwen is called after transcript.final has passed
# cross-mic filtering; it never receives realtime partial text. `think:false`
# is sent in every Ollama request. Qwen2.5:3B is the demo baseline.
MINUTES_COMPOSER_ENABLED=true
# timeline = evidence-only, formatted transcript by time (safe default).
# Switch to llm only after validating the model on the actual meeting domain.
MINUTES_COMPOSER_MODE=timeline
MINUTES_COMPOSER_MODEL=qwen2.5:3b
MINUTES_COMPOSER_TIMEOUT_SECONDS=45
MINUTES_COMPOSER_DEBOUNCE_SECONDS=0.4
MINUTES_COMPOSER_NUM_THREADS=12
MINUTES_COMPOSER_TEMPERATURE=0
MINUTES_COMPOSER_MAX_OUTPUT_TOKENS=200
MINUTES_COMPOSER_MAX_CONTEXT_CHARS=3200
MINUTES_COMPOSER_CONTEXT_WINDOW=2048
# Giữ model trong RAM trong lúc demo để tránh cold-start ở global turn sau.
MINUTES_COMPOSER_KEEP_ALIVE=-1

# Phonetic recovery runs only on a final transcript before it becomes evidence.
# Raw realtime partial text is never rewritten.
PHONETIC_RECOVERY_ENABLED=true
PHONETIC_DICTIONARY_PATH=/home/ntd/meeting_runtime/data/phonetic_dictionary.txt
PHONETIC_RECOVERY_THRESHOLD=0.86
PHONETIC_RECOVERY_MARGIN=0.06
PHONETIC_RECOVERY_MAX_WORDS=4
# grapheme | g2p_onnx. Keep grapheme for baseline; enable G2P only for A/B.
# G2P runs only on final segments, never on realtime partials.
PHONETIC_BACKEND=g2p_onnx
PHONETIC_G2P_MODEL_PATH=/home/ntd/meeting_runtime/models/g2p_multilingual_byT5_tiny_onnx
PHONETIC_G2P_LANGUAGE=vie-c
PHONETIC_G2P_THREADS=4
PHONETIC_G2P_WEIGHT=0.65
PHONETIC_G2P_PREFILTER=0.80
PHONETIC_G2P_MAX_CALLS=8
# Require an IPA result even for exact dictionary aliases (Sailor A/B only).
PHONETIC_G2P_FORCE=false
# Always-ready final-turn gate: Epitran + ByT5 G2P ONNX + SEA-G2P. It runs
# only after a dictionary candidate prefilter and falls back to G2P if missing.
PHONETIC_TRIPLE_WEIGHT=0.75
PHONETIC_TRIPLE_MIN_CONSENSUS=2
PHONETIC_TRIPLE_CONSENSUS_TOLERANCE=0.18
