{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simplething.id.vn/contracts/meeting-snapshot-v1.schema.json",
  "title": "Meeting snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "meeting_id",
    "snapshot_revision",
    "meeting",
    "actor",
    "participants"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "meeting_id": {"type": "string", "format": "uuid"},
    "snapshot_revision": {"type": "integer", "minimum": 1},
    "meeting": {"$ref": "#/$defs/meeting"},
    "actor": {"$ref": "#/$defs/actor"},
    "participants": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/participant"}
    },
    "hotwords": {
      "type": "array",
      "default": [],
      "items": {"$ref": "#/$defs/hotword"}
    }
  },
  "$defs": {
    "role": {
      "type": "string",
      "enum": ["CHAIRPERSON", "SECRETARY", "ADMIN", "MEMBER", "OBSERVER"]
    },
    "permission": {
      "type": "string",
      "enum": [
        "VIEW",
        "JOIN",
        "CONTROL",
        "EDIT_MINUTES",
        "APPROVE_MINUTES",
        "EXPORT_DRAFT",
        "DOWNLOAD_APPROVED"
      ]
    },
    "meeting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "status"],
      "properties": {
        "code": {"type": ["string", "null"], "maxLength": 64},
        "title": {"type": "string", "minLength": 1, "maxLength": 500},
        "status": {
          "type": "string",
          "enum": ["CREATED", "APPROVED", "ONGOING", "COMPLETED", "CANCELLED", "ARCHIVED"]
        },
        "scheduled_start": {"type": ["string", "null"], "format": "date-time"},
        "started_at": {"type": ["string", "null"], "format": "date-time"},
        "ended_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user_id", "role", "permissions"],
      "properties": {
        "user_id": {"type": "string", "format": "uuid"},
        "display_name": {"type": ["string", "null"], "maxLength": 160},
        "role": {"$ref": "#/$defs/role"},
        "permissions": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/permission"}
        }
      }
    },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user_id", "display_name", "role"],
      "properties": {
        "user_id": {"type": "string", "format": "uuid"},
        "display_name": {"type": "string", "minLength": 1, "maxLength": 160},
        "role": {"$ref": "#/$defs/role"}
      }
    },
    "hotword": {
      "type": "object",
      "additionalProperties": false,
      "required": ["term", "source"],
      "properties": {
        "term": {"type": "string", "minLength": 1, "maxLength": 160},
        "weight": {"type": "number", "minimum": 0},
        "source": {"type": "string", "enum": ["participant", "manual", "adaptive"]}
      }
    }
  }
}
