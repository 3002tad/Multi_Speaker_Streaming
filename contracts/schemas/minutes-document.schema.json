{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simplething.id.vn/contracts/minutes-document-v1.schema.json",
  "title": "Structured meeting minutes document v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "meeting", "summary", "topics", "source_segment_ids"],
  "properties": {
    "schema_version": {"const": 1},
    "meeting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "started_at"],
      "properties": {
        "title": {"type": "string", "maxLength": 500},
        "started_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "summary": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidence_item"}
    },
    "topics": {
      "type": "array",
      "items": {"$ref": "#/$defs/topic"}
    },
    "source_segment_ids": {"$ref": "#/$defs/source_ids"}
  },
  "$defs": {
    "source_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 160}
    },
    "evidence_source_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 160}
    },
    "item_id": {
      "description": "Optional in AI output; Meeting Service assigns it before persistence.",
      "type": "string",
      "format": "uuid"
    },
    "evidence_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content", "source_segment_ids"],
      "properties": {
        "item_id": {"$ref": "#/$defs/item_id"},
        "speaker": {"type": ["string", "null"], "maxLength": 160},
        "content": {"type": "string", "minLength": 1},
        "source_segment_ids": {"$ref": "#/$defs/evidence_source_ids"}
      }
    },
    "action_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task", "source_segment_ids"],
      "properties": {
        "item_id": {"$ref": "#/$defs/item_id"},
        "speaker": {"type": ["string", "null"], "maxLength": 160},
        "task": {"type": "string", "minLength": 1},
        "owner": {"type": ["string", "null"], "maxLength": 160},
        "deadline": {"type": ["string", "null"], "maxLength": 160},
        "source_segment_ids": {"$ref": "#/$defs/evidence_source_ids"}
      }
    },
    "topic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "details",
        "proposals",
        "decisions",
        "actions",
        "source_segment_ids"
      ],
      "properties": {
        "item_id": {"$ref": "#/$defs/item_id"},
        "title": {"type": "string", "minLength": 1, "maxLength": 500},
        "details": {"type": "array", "items": {"$ref": "#/$defs/evidence_item"}},
        "proposals": {"type": "array", "items": {"$ref": "#/$defs/evidence_item"}},
        "decisions": {"type": "array", "items": {"$ref": "#/$defs/evidence_item"}},
        "actions": {"type": "array", "items": {"$ref": "#/$defs/action_item"}},
        "source_segment_ids": {"$ref": "#/$defs/evidence_source_ids"}
      }
    }
  }
}
