MEETING_SERVICE_NAME=meeting-service
MEETING_SERVICE_HOST=0.0.0.0
MEETING_SERVICE_PORT=8002
MEETING_DATABASE_URL=postgresql://meeting:meeting@postgres-meeting:5432/meeting_service
MEETING_DB_PASSWORD=replace-with-a-secret
MEETING_PERSISTENCE_ENABLED=true
MEETING_SOCKETIO_PATH=meeting-runtime/socket.io
MEETING_ALLOWED_ORIGINS=https://meet.simplething.id.vn
MEETING_SERVICE_KEY=replace-with-a-secret-at-least-32-bytes
MEETING_AI_BASE_URL=http://meeting-ai-api:8001
MEETING_AI_ENABLED=false
MEETING_RUNTIME_TOKEN_SECRET=change-me-runtime-token-secret-32bytes
MEETING_RUNTIME_TOKEN_ALGORITHM=HS256
MEETING_RUNTIME_TOKEN_ISSUER=ecabinet
MEETING_RUNTIME_TOKEN_AUDIENCE=meeting-service
MEETING_LIVEKIT_URL=wss://livekit.simplething.id.vn
MEETING_LIVEKIT_API_KEY=replace-with-livekit-api-key
MEETING_LIVEKIT_API_SECRET=replace-with-livekit-api-secret
MEETING_LIVEKIT_TOKEN_TTL_SECONDS=900
MEETING_MINIO_ENDPOINT=minio-meeting:9000
MEETING_MINIO_ACCESS_KEY=meeting
MEETING_MINIO_SECRET_KEY=replace-with-minio-secret
MEETING_MINIO_BUCKET=meeting-minutes
MEETING_MINIO_SECURE=false
MEETING_EXPORT_ROOT=/app/runtime/exports
