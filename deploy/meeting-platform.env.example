# Copy outside the repository, for example:
# /home/ntd/meeting_runtime/meeting-platform.env
# Start with:
# docker compose --env-file /home/ntd/meeting_runtime/meeting-platform.env \
#   -f meeting_service/docker-compose.yml -f deploy/compose.meeting-platform.yml up -d --build

# Host path mounted to /runtime in meeting-ai-api. It contains models, Hugging
# Face cache, Qdrant profiles and runtime state; never put it in source control.
MEETING_RUNTIME_HOST_PATH=/home/ntd/meeting_runtime

# Required shared service secret, 24+ random characters.
MEETING_SERVICE_KEY=replace-with-the-same-internal-service-key
INTERNAL_API_KEY=replace-with-the-same-internal-service-key

# LiveKit public endpoint and server credentials.
LIVEKIT_URL=wss://livekit.example.vn
LIVEKIT_API_KEY=replace_me
LIVEKIT_API_SECRET=replace_me

# Initial model for the Ollama container. Pull it after first start:
# docker compose ... exec ollama ollama pull qwen2.5:3b
MINUTES_COMPOSER_MODEL=qwen2.5:3b
TOPIC_DISCOVERY_MODEL=qwen2.5:3b
OLLAMA_KEEP_ALIVE=-1

