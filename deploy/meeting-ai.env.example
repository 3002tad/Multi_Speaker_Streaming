# Private file outside source: /home/ntd/meeting_runtime/.env.ai
# MEETING_SERVICE_KEY must exactly equal the value in .env.meeting.
INTERNAL_API_KEY=replace-with-one-random-32-plus-character-service-key
MEETING_SERVICE_KEY=replace-with-one-random-32-plus-character-service-key

LIVEKIT_URL=wss://livekit.example.vn
LIVEKIT_API_KEY=replace_me
LIVEKIT_API_SECRET=replace_me

MINUTES_COMPOSER_MODEL=qwen2.5:3b
MINUTES_COMPOSER_MODE=llm
OLLAMA_KEEP_ALIVE=-1
OLLAMA_WARMUP_ENABLED=true
OLLAMA_WARMUP_TIMEOUT_SECONDS=90
SHUTDOWN_FLUSH_TIMEOUT_SECONDS=15
