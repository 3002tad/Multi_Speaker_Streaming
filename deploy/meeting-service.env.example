# Private file outside source: /home/ntd/meeting_runtime/.env.meeting
# Never commit the populated file. Values marked replace must be changed.
MEETING_SERVICE_KEY=replace-with-one-random-32-plus-character-service-key
MEETING_RUNTIME_TOKEN_SECRET=replace-with-a-different-random-32-plus-character-token-key
MEETING_DB_PASSWORD=replace-with-postgres-password
MEETING_MINIO_ACCESS_KEY=meeting
MEETING_MINIO_SECRET_KEY=replace-with-minio-secret

MEETING_LIVEKIT_URL=wss://livekit.example.vn
MEETING_LIVEKIT_API_KEY=replace_me
MEETING_LIVEKIT_API_SECRET=replace_me
MEETING_ALLOWED_ORIGINS=https://meet.example.vn
