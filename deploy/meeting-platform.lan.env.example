# Copy outside source, e.g. /home/ntd/meeting_runtime/meeting-platform.lan.env.
# Do not commit the populated file.
MEETING_RUNTIME_HOST_PATH=/home/ntd/meeting_runtime

# Windows laptop IPv4 on the office LAN; reserve it in DHCP if possible.
MEETING_LAN_HOST_IP=192.168.1.50
# An IP literal works with the Caddy default_sni setting and avoids editing
# DNS/hosts files on phones. If office DNS is available, use a hostname that
# resolves to MEETING_LAN_HOST_IP instead.
MEETING_LAN_TLS_HOST=192.168.1.50
LIVEKIT_PUBLIC_URL=wss://192.168.1.50:7880
LIVEKIT_INTERNAL_URL=ws://livekit:7880

# Generate unique values for every handoff/demo environment.
LIVEKIT_API_KEY=lan_demo_key
LIVEKIT_API_SECRET=replace-with-a-random-32-plus-character-livekit-secret
INTERNAL_API_KEY=replace-with-a-random-32-plus-character-service-key
MEETING_SERVICE_KEY=replace-with-the-same-service-key
MEETING_RUNTIME_TOKEN_SECRET=replace-with-a-different-random-32-plus-character-token-key
MEETING_DB_PASSWORD=replace-with-postgres-password
MEETING_MINIO_ACCESS_KEY=meeting
MEETING_MINIO_SECRET_KEY=replace-with-minio-secret

MINUTES_COMPOSER_MODEL=qwen2.5:3b
# Allow the first CPU-only Qwen request to include model warm-up time.
MINUTES_COMPOSER_TIMEOUT_SECONDS=120
MEETING_MINUTES_AUTO_UPDATE_DEBOUNCE_SECONDS=5
TOPIC_DISCOVERY_MODEL=qwen2.5:3b
OLLAMA_KEEP_ALIVE=-1
