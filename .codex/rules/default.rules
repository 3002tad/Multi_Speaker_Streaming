# Các thao tác Git chỉ đọc.
prefix_rule(
    pattern = ["git", ["status", "diff", "log", "show"]],
    decision = "allow",
    justification = "Các lệnh Git chỉ đọc được phép tự chạy.",
)

# Cho phép chạy pytest bằng đúng Python runtime của project.
prefix_rule(
    pattern = [
        "wsl.exe",
        "--cd",
        "/mnt/d/VNPT/Code/Multi_Speaker_Streaming",
        "/home/ntd/meeting_runtime/venv_linux/bin/python",
        "-B",
        "-m",
        "pytest",
    ],
    decision = "allow",
    justification = "Cho phép chạy kiểm thử bằng runtime WSL đã khóa.",
)

# Luôn hỏi trước khi thao tác server.
prefix_rule(
    pattern = ["ssh", "ntdserver"],
    decision = "prompt",
    justification = "Mọi thay đổi trên home server phải được xác nhận.",
)

# Cấm các thao tác Git có khả năng làm mất dữ liệu.
prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "Không được xóa thay đổi trong worktree; dùng phương án phục hồi có chọn lọc.",
)

prefix_rule(
    pattern = ["git", "clean", "-fd"],
    decision = "forbidden",
    justification = "Không được xóa hàng loạt file chưa được Git theo dõi.",
)

# Luôn hỏi trước khi commit hoặc push.
prefix_rule(
    pattern = ["git", ["commit", "push"]],
    decision = "prompt",
    justification = "Người dùng cần xác nhận nội dung trước khi commit hoặc push.",
)